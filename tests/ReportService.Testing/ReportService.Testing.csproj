<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared support for the test projects: repository paths, the composition's
    pinned images, a bounded wait, an in-memory log capture and the container
    helper of the integration suite. Referenced by test projects only; it holds
    no product behaviour and no tests.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

</Project>
