<tr><td class="col-seq">{{ item.sequence }}</td><td class="col-date">{{ item.date | format_date: "dd/MM/yyyy" }}</td><td class="col-description">{{ item.description }}</td><td class="col-qty">{{ item.quantity }}</td><td class="col-unit">{{ item.unitPrice }}</td><td class="col-amount">{{ item.amount | format_number: "N2" }}</td></tr>