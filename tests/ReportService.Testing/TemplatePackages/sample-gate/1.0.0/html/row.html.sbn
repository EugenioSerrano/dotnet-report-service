<tr><td class="col-seq">{{ item.sequence | html.escape }}</td><td class="col-date">{{ format_date item.date "dd/MM/yyyy" | html.escape }}</td><td class="col-description">{{ item.description | html.escape }}</td><td class="col-qty">{{ item.quantity | html.escape }}</td><td class="col-unit">{{ item.unitPrice | html.escape }}</td><td class="col-amount">{{ format_number item.amount "N2" | html.escape }}</td></tr>