<tr><td class="col-seq">{{ item.sequence }}</td><td class="col-date">{{ format_date item.date "dd/MM/yyyy" }}</td><td class="col-description">{{ item.description | html.escape }}</td><td class="col-qty">{{ item.quantity }}</td><td class="col-unit">{{ item.unitPrice }}</td><td class="col-amount">{{ format_number item.amount "N2" }}</td></tr>