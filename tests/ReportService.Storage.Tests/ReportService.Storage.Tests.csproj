<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit and component tests of ReportService.Storage (the object storage
    port) and ReportService.Storage.Filesystem (its Filesystem provider).
    Hermetic: no container, no network; files only under a temporary directory
    unique to each test. It also holds the provider-conformance suite
    (ObjectStoreConformanceTests), which every provider's test project derives.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Storage\ReportService.Storage.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Storage.Filesystem\ReportService.Storage.Filesystem.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
