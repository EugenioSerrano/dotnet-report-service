<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit and component tests of ReportService.Workers.Pdf: the take's
    registration on the queue the process declares — one work registration, one
    concurrency — and the activity as a plain class, with each of the take's
    answers mapped to the failure the engine is given. Hermetic: no container, no
    socket, no engine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Workers.Pdf\ReportService.Workers.Pdf.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Storage.Filesystem\ReportService.Storage.Filesystem.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Rendering\ReportService.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Pdf.Verification\ReportService.Pdf.Verification.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
