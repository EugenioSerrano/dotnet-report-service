  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Pdf\ReportService.Pdf.PageCodes.QrCoder\ReportService.Pdf.PageCodes.QrCoder.csproj" />
    <ProjectReference Include="..\..\..\src\Pdf\ReportService.Pdf.Assembly\ReportService.Pdf.Assembly.csproj" />
  </ItemGroup>

</Project>
