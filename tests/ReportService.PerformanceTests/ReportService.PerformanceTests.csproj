<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Measurements of the data and verification paths: the reading-and-validation pass over
    the deterministic volume datasets, the per-record cost of that validation, and the
    verification's smoke thresholds of the reference environment. Not a hermetic project
    and not part of the integration suite: the smoke prints the documents through the
    rendering host image and measures them in process, on the reference environment only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Data\ReportService.Data.csproj" />
    <ProjectReference Include="..\..\src\ReportService.DataContract\ReportService.DataContract.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Pdf.Verification\ReportService.Pdf.Verification.csproj" />
    <ProjectReference Include="..\..\src\ReportService.TemplatePackages\ReportService.TemplatePackages.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Templates\ReportService.Templates.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
