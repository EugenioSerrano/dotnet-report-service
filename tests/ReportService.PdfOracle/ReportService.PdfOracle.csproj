<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The independent judge of a printed document: it reads a PDF with the text
    tools installed in its own image and judges the printed words against the
    data the document was printed from. It references no product assembly and no
    PDF library, so its verdict is reached without the code it judges.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReportService.PdfOracle.Tests" />
    <!-- The drift case reads every declaration the judge is handed, through the same parser. -->
    <InternalsVisibleTo Include="ReportService.Fixtures.Tests" />
  </ItemGroup>

</Project>
