<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit and component tests of the orchestration worker: the verifier that
    reads one stored upload once and fixes its snapshot, the checksum and the
    attestation it decides by, the activity's options and the dispatcher's
    rules. Hermetic: no container, no network, no workflow engine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Storage.Filesystem\ReportService.Storage.Filesystem.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Uploads\ReportService.Uploads.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Workers.Orchestration\ReportService.Workers.Orchestration.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded verification histories the replay case replays, beside the suite that consumes them. -->
    <Content Include="Histories\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
