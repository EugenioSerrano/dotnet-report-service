<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the snapshot reading and partitioning library: the forward-only
    reader of the document profile, the limits it enforces, the single-block
    partitioner, the block document it writes and the index page. Hermetic: no
    container, no network, no database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Jobs\ReportService.Data\ReportService.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared conformance cases of the image data URI definition, linked rather than
         referenced so that this project keeps measuring only its own assembly. -->
    <Compile Include="..\..\Support\ReportService.Testing\ImageDataUriVectors.cs" Link="Shared\ImageDataUriVectors.cs" />
  </ItemGroup>

</Project>
