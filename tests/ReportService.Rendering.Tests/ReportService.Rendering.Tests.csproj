<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of printing a block: the package route policy that confines every
    request of a document to the package, the media types of a package file, and
    the reachability of the two test-only seams. Hermetic: no container, no browser.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Rendering\ReportService.Rendering.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
