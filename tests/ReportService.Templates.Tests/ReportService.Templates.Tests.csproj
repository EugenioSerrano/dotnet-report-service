<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of composing a block: the render context built from raw JSON, the
    package file names, the caller-side guards, the Scriban adapter and its
    escaping policy, the block composer and its fragment map, and the prepared
    package cache. Hermetic: no container, no network, no browser.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Templates\ReportService.Templates.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
