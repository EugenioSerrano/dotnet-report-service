<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests over the whole local composition, started from a test
    through the Aspire testing host. Needs the container runtime and the local
    development registry the composition itself needs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.AppHost\ReportService.AppHost.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
