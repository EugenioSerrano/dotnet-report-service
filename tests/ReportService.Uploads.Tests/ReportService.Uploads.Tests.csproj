<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the shared upload library: the wire and stored forms of its
    values, the identifier's grammar, the snapshot record and the store contract on
    the in-memory double. Hermetic: no container, no network, no database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Uploads\ReportService.Uploads.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
