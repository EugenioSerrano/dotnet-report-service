<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rendering regression suite: it prints the core tier of the fixture library
    with the product composer and printer inside the rendering host image, reads
    every printed document with the independent judge in its own image, and holds
    the two readers' answers together. It needs a container runtime and the local
    development registry; it is not part of the hermetic level.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The container image tag the rendering suite references, derived from the
    solution-wide VersionPrefix/VersionSuffix (Directory.Build.props) — the same
    single source of truth and the same expression ReportService.RenderingHost.csproj
    uses for its ContainerImageTag. Surfaced as assembly metadata so the suite
    resolves the tag at runtime without a hard-coded literal.
  -->
  <PropertyGroup>
    <RenderingImageTag>$(VersionPrefix)</RenderingImageTag>
    <RenderingImageTag Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</RenderingImageTag>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RenderingImageTag" Value="$(RenderingImageTag)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Support\ReportService.Testing\ReportService.Testing.csproj" />
    <ProjectReference Include="..\..\..\src\Jobs\ReportService.Data\ReportService.Data.csproj" />
    <ProjectReference Include="..\..\..\src\Pdf\ReportService.Pdf.Verification\ReportService.Pdf.Verification.csproj" />
    <ProjectReference Include="..\..\..\src\Templates\ReportService.TemplateChecks\ReportService.TemplateChecks.csproj" />
    <ProjectReference Include="..\..\..\src\Templates\ReportService.TemplateSource\ReportService.TemplateSource.csproj" />
    <!-- The measurement reads the delivered take deadline, the render budget and the activity's bound. -->
    <ProjectReference Include="..\..\..\src\ReportService.Workers.Pdf\ReportService.Workers.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ReaderCases\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
