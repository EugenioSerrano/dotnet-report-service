<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A private dependency of the test page-code generator assembly. It is never
    referenced by a test process: the page-code loading tests copy it beside the
    generator assembly in a temporary directory and prove that the generator's load
    context resolves it from there, and that its absence fails the load naming it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
