<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the shared report job library: the identifiers' grammar, the
    wire and stored forms of its values, and the job store contract on the
    in-memory double. Hermetic: no container, no network, no database.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Jobs\ReportService.Jobs.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
