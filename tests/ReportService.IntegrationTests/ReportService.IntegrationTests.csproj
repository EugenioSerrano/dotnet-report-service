<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests against the real dependencies of the composition, each
    started in its own container at the version pinned in
    src/ReportService.AppHost/composition-pins.json. Needs a container runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
    <!-- Hosted in memory by the readiness tests. Both have a top-level Program class, so the worker's is reached through its alias. -->
    <ProjectReference Include="..\..\src\ReportService.Api\ReportService.Api.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Migrations\ReportService.Migrations.csproj" />
    <ProjectReference Include="..\..\src\ReportService.Workers.Orchestration\ReportService.Workers.Orchestration.csproj" Aliases="orchestration" />
    <!-- Hosted in memory by the take's worker-level class; reached through its alias like the orchestration worker's. -->
    <ProjectReference Include="..\..\src\ReportService.Workers.Pdf\ReportService.Workers.Pdf.csproj" Aliases="pdf" />
  </ItemGroup>

</Project>
