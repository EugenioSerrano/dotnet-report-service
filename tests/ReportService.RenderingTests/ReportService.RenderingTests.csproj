<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rendering regression suite: it prints the core tier of the fixture library
    with the product composer and printer inside the rendering host image, reads
    every printed document with the independent judge in its own image, and holds
    the two readers' answers together. It needs a container runtime and the local
    development registry; it is not part of the hermetic level.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
