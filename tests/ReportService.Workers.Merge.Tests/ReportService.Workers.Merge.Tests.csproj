<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit/component tests of the merge worker: the assembly step over a real
    filesystem object store, the in-memory job store, a taken package holding the
    packaged font, and a real assembly. Hermetic: every document is generated in the
    test's own temporary directory; no browser, no container, no network.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Workers.Merge\ReportService.Workers.Merge.csproj" />
    <ProjectReference Include="..\..\src\Platform\ReportService.Storage.Filesystem\ReportService.Storage.Filesystem.csproj" />
    <ProjectReference Include="..\Support\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Support\ReportService.Testing\Fonts\LiberationSans-Regular.ttf"
          Link="Fonts\LiberationSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
