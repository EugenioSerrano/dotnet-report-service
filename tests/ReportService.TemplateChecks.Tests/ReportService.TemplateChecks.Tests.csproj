<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the take's static checks: the fixed order, the refusal message,
    the schema profile and the pattern rule, the sample against its schema, the
    anchors, the syntax per engine, the includes and assets, the lint, the engine
    version, the budget and the PDF constraints. Hermetic: no container, no network,
    no browser. ProjectReference to the printing assembly only for the document-base
    cross-check; the checks themselves do not reference it. The test-support library
    supplies the per-engine packages the PDF rules are exercised over and the path
    of the repository the shipped samples are read from.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.Rendering\ReportService.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ReportService.TemplateChecks\ReportService.TemplateChecks.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
