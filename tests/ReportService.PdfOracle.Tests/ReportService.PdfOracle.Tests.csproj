<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Holds the judge to its own rules: a document built by hand that passes, the
    same document changed one way at a time so that every failure it must report
    is reported, and the reading of the text tool's output. Hermetic: no container,
    no network, no PDF tool.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.PdfOracle\ReportService.PdfOracle.csproj" />
    <ProjectReference Include="..\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

</Project>
