<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit and component tests of the HTML output family: the self-contained assembly and its asset inlining, the assembly step, its execution and its publication. Hermetic: no container, no network, no browser.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Platform\ReportService.Storage.Filesystem\ReportService.Storage.Filesystem.csproj" />
    <ProjectReference Include="..\..\..\src\Jobs\ReportService.Uploads\ReportService.Uploads.csproj" />
    <ProjectReference Include="..\..\..\src\ReportService.Workers.Orchestration\ReportService.Workers.Orchestration.csproj" />
    <ProjectReference Include="..\..\Support\ReportService.Testing\ReportService.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory package the composer's suite reads, shared as source with that suite. -->
    <Compile Include="..\..\Templates\ReportService.Templates.Tests\MemoryPackageFiles.cs" Link="Shared\MemoryPackageFiles.cs" />
  </ItemGroup>

</Project>
