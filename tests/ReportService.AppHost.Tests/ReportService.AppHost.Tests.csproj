<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of ReportService.AppHost. Hermetic: no container, no network, no Aspire runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The child flooder's built binary, surfaced to the reproduction test as assembly
    metadata (mirroring ReportService.Fixtures.Tests) so the test resolves it at
    runtime without a hard-coded literal. It tracks the same Configuration and
    TargetFramework this test project builds under.
  -->
  <PropertyGroup>
    <StreamFlooderDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Support\ReportService.Testing.StreamFlooder\bin\$(Configuration)\$(TargetFramework)\ReportService.Testing.StreamFlooder.dll'))</StreamFlooderDll>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StreamFlooderDll" Value="$(StreamFlooderDll)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReportService.AppHost\ReportService.AppHost.csproj" />
    <!-- Build-only: the flooder is built with this level but adds no assembly dependency. -->
    <ProjectReference Include="..\Support\ReportService.Testing.StreamFlooder\ReportService.Testing.StreamFlooder.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
