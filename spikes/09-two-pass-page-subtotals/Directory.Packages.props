<Project>
  <!--
    Package versions of this experiment only. Kept apart from the root file so
    the experiment never changes the product's central package versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a version listed here also pin a package that is only a dependency of another one. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- First pass: Chromium's own print layout, as in spikes/07-native-tall-rows. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Second pass: reads the row markers back, stamps the reserved area and saves. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!--
      Dependency of PDFsharp (digital signatures). The version PDFsharp asks for
      has known vulnerabilities; the next patch release has none. Same pin as
      spikes/03-pdf-assembly.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
</Project>
