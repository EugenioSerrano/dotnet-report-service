<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Check of the group-continuity-across-blocks experiment. It reads each
    assembled PDF with poppler-utils only. Linked unchanged: everything the
    check of spikes/12-group-continuity links (the strict accounting check,
    character check and run-record reader of
    spikes/10-pagedjs-table-strict-accounting, with the files they need from
    spikes/02, 03, 07 and 09), plus that folder's group-fixture builder and group
    check. New here: the parts and their hand-over, the report-level accounting
    and group checks across part boundaries, the boundary observations, the
    controls, the parity comparison and the verdict. No package; no browser and no
    PDF library.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GroupContinuityCheck</RootNamespace>
    <AccountingCheck>$(MSBuildThisFileDirectory)../../09-two-pass-page-subtotals/PageAccountingCheck/</AccountingCheck>
    <StrictCheck>$(MSBuildThisFileDirectory)../../10-pagedjs-table-strict-accounting/StrictAccountingCheck/</StrictCheck>
    <GroupCheck>$(MSBuildThisFileDirectory)../../12-group-continuity/GroupContinuityCheck/</GroupCheck>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../07-native-tall-rows/PaginationFixtures/PaginationFixtures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../07-native-tall-rows/TextIntegrityCheck/Poppler.cs" Link="Linked/Poppler.cs" />
    <Compile Include="../../07-native-tall-rows/TextIntegrityCheck/PrintedDocument.cs" Link="Linked/PrintedDocument.cs" />
    <Compile Include="../../07-native-tall-rows/TextIntegrityCheck/TextNormalisation.cs" Link="Linked/TextNormalisation.cs" />
    <Compile Include="../../07-native-tall-rows/TextIntegrityCheck/IntegrityRules.cs" Link="Linked/IntegrityRules.cs" />
    <Compile Include="../../02-pdf-layout/PdfLayoutSpike/AccountingVerifier.cs" Link="Linked/AccountingVerifier.cs" />
    <Compile Include="../../02-pdf-layout/PdfLayoutSpike/BlockSource.cs" Link="Linked/BlockSource.cs" />
    <Compile Include="../../02-pdf-layout/PdfLayoutSpike/ProcessTreeSampler.cs" Link="Linked/ProcessTreeSampler.cs" />
    <Compile Include="../../03-pdf-assembly/PdfAssemblySpike/PgmImage.cs" Link="Linked/PgmImage.cs" />
    <Compile Include="$(AccountingCheck)Evaluation.cs" Link="Linked/Evaluation.cs" />
    <Compile Include="$(AccountingCheck)PdfReading.cs" Link="Linked/PdfReading.cs" />
    <Compile Include="$(AccountingCheck)Records.cs" Link="Linked/Records.cs" />
    <Compile Include="$(AccountingCheck)ReadBackJudge.cs" Link="Linked/ReadBackJudge.cs" />
    <Compile Include="$(AccountingCheck)UnchangedOutside.cs" Link="Linked/UnchangedOutside.cs" />
    <Compile Include="$(AccountingCheck)StampingSideEffects.cs" Link="Linked/StampingSideEffects.cs" />
    <Compile Include="$(AccountingCheck)Qpdf.cs" Link="Linked/Qpdf.cs" />
    <Compile Include="$(AccountingCheck)Tool.cs" Link="Linked/Tool.cs" />
    <Compile Include="$(AccountingCheck)Reused/LayoutTypes.cs" Link="Linked/LayoutTypes.cs" />
    <Compile Include="$(StrictCheck)Account.cs" Link="Linked/Account.cs" />
    <Compile Include="$(StrictCheck)CharacterCheck.cs" Link="Linked/CharacterCheck.cs" />
    <Compile Include="$(StrictCheck)HarnessRecords.cs" Link="Linked/HarnessRecords.cs" />
    <Compile Include="$(GroupCheck)GroupFixtures.cs" Link="Linked/GroupFixtures.cs" />
    <Compile Include="$(GroupCheck)GroupCheck.cs" Link="Linked/GroupCheck.cs" />
  </ItemGroup>
</Project>
