# Allow-list build context for the table-and-grid harness image: everything is
# excluded, then only the files the build stage copies are let back in (the
# files of spikes/02-pdf-layout, spikes/07-native-tall-rows and
# spikes/08-pagedjs-pre-split read only).
*
!global.json
!Directory.Build.props
!NuGet.config
!.editorconfig
!spikes/Directory.Build.props
!spikes/10-pagedjs-table-strict-accounting/Directory.Packages.props
!spikes/10-pagedjs-table-strict-accounting/PagedMarkupSpike/**
!spikes/08-pagedjs-pre-split/PreSplitLayoutSpike/PageBuilder.cs
!spikes/08-pagedjs-pre-split/PreSplitLayoutSpike/RunRecord.cs
!spikes/08-pagedjs-pre-split/PreSplitLayoutSpike/assets/pre-split.js
!spikes/08-pagedjs-pre-split/PreSplitLayoutSpike/assets/fixture.css
!spikes/07-native-tall-rows/Directory.Packages.props
!spikes/07-native-tall-rows/PaginationFixtures/**
!spikes/02-pdf-layout/PdfLayoutSpike/AccountingVerifier.cs
!spikes/02-pdf-layout/PdfLayoutSpike/BlockHtmlBuilder.cs
!spikes/02-pdf-layout/PdfLayoutSpike/BlockSource.cs
!spikes/02-pdf-layout/PdfLayoutSpike/LayoutRunner.cs
!spikes/02-pdf-layout/PdfLayoutSpike/ProcessTreeSampler.cs
!spikes/02-pdf-layout/PdfLayoutSpike/assets/**
spikes/10-pagedjs-table-strict-accounting/PagedMarkupSpike/bin
spikes/10-pagedjs-table-strict-accounting/PagedMarkupSpike/obj
spikes/07-native-tall-rows/PaginationFixtures/bin
spikes/07-native-tall-rows/PaginationFixtures/obj
