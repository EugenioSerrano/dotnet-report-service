!spikes/02-pdf-layout/PdfLayoutSpike/ProcessTreeSampler.cs
!spikes/03-pdf-assembly/PdfAssemblySpike/PgmImage.cs
!spikes/09-two-pass-page-subtotals/PageAccountingCheck/Evaluation.cs
!spikes/09-two-pass-page-subtotals/PageAccountingCheck/PdfReading.cs
!spikes/09-two-pass-page-subtotals/PageAccountingCheck/Records.cs
!spikes/09-two-pass-page-subtotals/PageAccountingCheck/ReadBackJudge.cs
!spikes/09-two-pass-page-subtotals/PageAccountingCheck/UnchangedOutside.cs
