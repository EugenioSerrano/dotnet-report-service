<Project>
  <!--
    Package versions of this experiment only. Kept apart from the root file so
    the experiment never changes the product's central package versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a version listed here also pin a package that is only a dependency of another one. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Candidate reader of words, positions and pages (Apache-2.0). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Candidate measured for what it can read at all (MIT, the platform's pinned version). -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!--
      Dependency of PDFsharp. The version PDFsharp asks for has known
      vulnerabilities; the next patch release has none. Same pin as the
      earlier assembly and two-pass experiments.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
</Project>
