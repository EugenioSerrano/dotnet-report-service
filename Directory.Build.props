<Project>
  <!--
    Repository-wide MSBuild properties, imported automatically by every project
    below this folder.
    - Target framework and analyzer level are shared defaults; a project may
      override them explicitly when it has a reason to.
    - The SDK band is pinned in global.json.
    - Package versions live only in Directory.Packages.props.
    - The product version below is changed only when a release is made.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Product version (Semantic Versioning). One version for the whole
      repository. Between releases builds carry the "dev" pre-release label
      (VersionSuffix); a released version has none.
    -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <!-- Pre-release label while this version is in progress; removed when the version is released. -->
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Eugenio Serrano</Authors>
    <Copyright>Copyright (c) 2026 Eugenio Serrano</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EugenioSerrano/dotnet-report-service</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EugenioSerrano/dotnet-report-service</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The commit every build reports in its informational version
    (X.Y.Z-dev+<commit>): the SDK reads <see cref="SourceRevisionId"/> when it is
    already set, and its own source-control integration fills it from the git
    directory. A source tree without git leaves it empty, so this target asks git
    directly and falls back to "unknown" — a build never fails for it and a
    commit is never invented.
  -->
  <Target Name="AddSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == '' AND '$(_GitCommit)' != ''">$([System.String]::Copy('$(_GitCommit)').Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
