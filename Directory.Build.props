<Project>
  <!--
    Repository-wide MSBuild properties, imported automatically by every project
    below this folder.
    - Target framework and analyzer level are shared defaults; a project may
      override them explicitly when it has a reason to.
    - The SDK band is pinned in global.json.
    - Package versions live only in Directory.Packages.props.
    - The product version below is changed only when a release is made.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    REV-001 F-03: a hermetic behaviour run (the TDD inner loop) does not need
    analyzer and code-style gating on the test projects, and that gating is a
    large share of each inner-loop build (×18 test projects). When the hermetic
    test runner issues its one build it sets HermeticBuild=true; only then, and
    only for the test projects (names ending in ".Tests"), the analyzer /
    code-style / warnings-as-errors gating is turned off. Every other build —
    any plain `dotnet build`, CI, a publish, and every production project — leaves
    HermeticBuild unset and keeps the full gating above. The dedicated lint step
    (see tests/README.md) is exactly such a full-gating build, so nothing that was
    enforced before stops being enforced; it is simply no longer paid on every
    inner-loop build of the test projects.
  -->
  <PropertyGroup Condition="'$(HermeticBuild)' == 'true' AND $(MSBuildProjectName.EndsWith('.Tests'))">
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Product version (Semantic Versioning). One version for the whole
      repository. Between releases builds carry the "dev" pre-release label
      (VersionSuffix); a released version has none.
    -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <!-- Pre-release label while this version is in progress; removed when the version is released. -->
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Eugenio Serrano</Authors>
    <Copyright>Copyright (c) 2026 Eugenio Serrano</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/EugenioSerrano/dotnet-report-service</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EugenioSerrano/dotnet-report-service</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The commit every build reports in its informational version
    (X.Y.Z-dev+<commit>): the SDK reads <see cref="SourceRevisionId"/> when it is
    already set, and its own source-control integration fills it from the git
    directory. A source tree without git leaves it empty, so this target asks git
    directly and falls back to "unknown" — a build never fails for it and a
    commit is never invented.
  -->
  <!--
    REV-001 F-04: when SourceRevisionId is already set (the hermetic test runner
    passes it once as an MSBuild property, having captured the commit itself), this
    target is skipped entirely, so the per-project `git rev-parse HEAD` Exec does
    not run ~45 times per build. When it is not set (any build the runner did not
    pass it to), the target runs exactly as before and falls back to "unknown" —
    a build never fails for it and a commit is never invented.
  -->
  <Target Name="AddSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == '' AND '$(_GitCommit)' != ''">$([System.String]::Copy('$(_GitCommit)').Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
