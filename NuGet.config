<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Only nuget.org is used, and package source mapping routes every package
    to it. Any additional feed must be added explicitly with its own package
    pattern, so a package can never be resolved from an unexpected source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
