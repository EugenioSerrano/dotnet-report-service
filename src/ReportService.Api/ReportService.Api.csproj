<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The API references the shared service conventions only: no workflow-engine package. -->
  <ItemGroup>
    <ProjectReference Include="..\ReportService.ServiceDefaults\ReportService.ServiceDefaults.csproj" />
    <ProjectReference Include="..\ReportService.Uploads\ReportService.Uploads.csproj" />
    <ProjectReference Include="..\ReportService.Jobs\ReportService.Jobs.csproj" />
    <!-- The taken version's record and store. The project holds no source client, so the
         API can name what it keeps without ever being able to read the repository. -->
    <ProjectReference Include="..\ReportService.TemplatePackages\ReportService.TemplatePackages.csproj" />
  </ItemGroup>

  <!-- The API keeps its own metadata records: explicit SQL over a pooled data source. -->
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- The development consumer registry; the running service watches it for changes. -->
  <ItemGroup>
    <Content Update="consumers.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
