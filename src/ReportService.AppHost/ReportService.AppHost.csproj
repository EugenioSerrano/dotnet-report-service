<Project Sdk="Aspire.AppHost.Sdk/13.6.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>c198e5be-9e05-4d7e-9647-24917db69352</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The dashboard and orchestration packages are restored from NuGet and
      pinned centrally in Directory.Packages.props; the Aspire CLI bundle is
      not used. The warning that recommends the bundle is therefore turned
      off for this project only.
    -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Api\ReportService.Api.csproj" />
    <ProjectReference Include="..\ReportService.Workers.Orchestration\ReportService.Workers.Orchestration.csproj" />
    <!--
      The migrator is composed as a project resource and its assembly is read
      here, so the expected schema version has one source. The AppHost SDK sets
      ReferenceOutputAssembly=false on a project reference with empty metadata;
      the metadata below keeps the reference.
    -->
    <ProjectReference Include="..\ReportService.Migrations\ReportService.Migrations.csproj"
                      ReferenceOutputAssembly="true"
                      ExcludeAssets="none"
                      Private="true"
                      SkipGetTargetFrameworkProperties="false" />
  </ItemGroup>

  <!-- The PostgreSQL image's init script: creates the application role and its database. -->
  <ItemGroup>
    <Content Include="postgres-init\10-application-role.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
