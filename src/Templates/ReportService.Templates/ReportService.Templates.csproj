<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The escaping encoders of the Handlebars and Liquid adapters implement the framework's
      encoder contracts, whose entry points take character pointers; the unsafe context is
      confined to those two internal encoders.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Composing a block into HTML: the adapter contract every template engine is
    reached through, the Scriban adapter, the render context, the escaping
    policy, the caller-side guards, the block composer and the prepared-template
    cache. No other product assembly references a template engine package.
  -->
  <ItemGroup>
    <PackageReference Include="Scriban" />
    <PackageReference Include="Handlebars.Net" />
    <PackageReference Include="Fluid.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jobs\ReportService.Data\ReportService.Data.csproj" />
    <ProjectReference Include="..\ReportService.TemplatePackages\ReportService.TemplatePackages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The parsing configuration and the presentation table stay internal; their own
         test project holds the cases that compare the take's parse with the render's.
         The rendering assembly is the one production grant: it holds the print call site
         and forwards the stall to this assembly's composer; the worker is not granted, so
         the process that runs the container cannot name, register or implement the seam. -->
    <InternalsVisibleTo Include="ReportService.Rendering" />
    <InternalsVisibleTo Include="ReportService.Templates.Tests" />
    <InternalsVisibleTo Include="ReportService.Rendering.Tests" />
    <InternalsVisibleTo Include="ReportService.Workers.Pdf.Tests" />
  </ItemGroup>

</Project>
