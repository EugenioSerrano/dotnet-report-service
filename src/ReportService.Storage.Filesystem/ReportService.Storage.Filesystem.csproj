<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Filesystem provider of the object storage port: objects are files
    under one root directory. A write goes to a uniquely named temporary file
    in the target directory, is flushed to disk and is then published under
    its key by a create-only operation, so an existing object is never
    overwritten and a partial object is never visible. Every path is checked
    under the root, links included. Base class library only; the shared
    framework reference supplies logging and dependency injection.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Storage\ReportService.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReportService.Storage.Tests" />
  </ItemGroup>

</Project>
