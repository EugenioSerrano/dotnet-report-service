{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": {
    "Diagnostics": {
      "Enabled": false,
      "ExportIntervalMilliseconds": 2000
    }
  },
  "Uploads": {
    "MaxStoredBytes": 4294967296,
    "MaxUncompressedBytes": 4294967296,
    "Verification": {
      "StartToClose": "01:00:00"
    }
  },
  "Dispatcher": {
    "PollInterval": "00:00:01",
    "BatchSize": 50,
    "AlertAfter": "00:05:00",
    "ClaimBudget": "00:00:30"
  },
  "Workers": {
    "DataActivitySlots": 2
  }
}
