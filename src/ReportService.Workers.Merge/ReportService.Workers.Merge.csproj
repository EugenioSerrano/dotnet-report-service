<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The merge worker: the Temporal worker that assembles one output's committed
    parts into the finished PDF. It carries no browser and no rendering dependency;
    it reads the taken package, assembles and verifies through the product's
    assembly library, and writes the one output-class object under the job's key.
  -->
  <PropertyGroup>
    <RootNamespace>ReportService.Workers.Merge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform\ReportService.ServiceDefaults.Temporal\ReportService.ServiceDefaults.Temporal.csproj" />
    <ProjectReference Include="..\Jobs\ReportService.Jobs\ReportService.Jobs.csproj" />
    <ProjectReference Include="..\Pdf\ReportService.Pdf.Assembly\ReportService.Pdf.Assembly.csproj" />
    <ProjectReference Include="..\Pdf\ReportService.Pdf.PageCodes.Hosting\ReportService.Pdf.PageCodes.Hosting.csproj" />
    <ProjectReference Include="..\Templates\ReportService.TemplatePackages\ReportService.TemplatePackages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReportService.Workers.Merge.Tests" />
  </ItemGroup>

</Project>
