<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The snapshot's data side: one forward-only reader of the document profile, the
    record model it yields, the limits the profile fixes, the single-block and the
    multi-block streaming partitioner and the block and index documents they write.
    Base class library only, with one exception: the durable partition driver reaches
    durable storage through the object-storage port (the ReportService.Storage
    reference below); no storage provider, database or workflow-engine type enters
    this library.
  -->
  <PropertyGroup>
    <RootNamespace>ReportService.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The object-storage port the durable partition driver writes blocks and the index page through. -->
    <ProjectReference Include="..\..\Platform\ReportService.Storage\ReportService.Storage.csproj" />
  </ItemGroup>

</Project>
