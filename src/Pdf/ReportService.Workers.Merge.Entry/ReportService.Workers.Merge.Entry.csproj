<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Workers.Merge\ReportService.Workers.Merge.csproj" />
  </ItemGroup>

  <!--
    Container image of the merge worker, built by the .NET SDK from this entry
    project:
      dotnet publish -c Release -t:PublishContainer
    The base is the platform matrix's ASP.NET Core runtime image (ADR-043): the
    worker runs no browser and needs no PDF base. The product version names the
    image tag; the process runs only as a Linux container, framework-dependent on
    the base's runtime.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0.0-resolute</ContainerBaseImage>
    <ContainerRepository>report-service-merge-worker</ContainerRepository>
    <ContainerImageTag>$(VersionPrefix)</ContainerImageTag>
    <ContainerImageTag Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

</Project>
