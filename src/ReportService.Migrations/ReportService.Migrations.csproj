<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one-shot migrator: it applies the embedded SQL scripts forward-only,
    each in its own transaction with its journal row, and exits 0 when the
    schema is current. The processes that use the database wait for it to
    finish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- The logical name is what the runner reads, independent of the folder layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.ServiceDefaults\ReportService.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
