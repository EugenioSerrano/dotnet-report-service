    reached through, the Scriban adapter, the render context, the escaping
    policy, the caller-side guards, the block composer and the prepared-template
    cache. No other product assembly references a template engine package.
  -->
  <ItemGroup>
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportService.Data\ReportService.Data.csproj" />
    <ProjectReference Include="..\ReportService.TemplatePackages\ReportService.TemplatePackages.csproj" />
  </ItemGroup>

</Project>
