    <tr><td class="num">{{ item.sequence | html.escape }}</td><td class="text">{{ item.groupId | html.escape }}</td><td class="text">{{ item.accountId | html.escape }}</td><td class="text">{{ item.description | html.escape }}</td><td class="num">{{ item.quantity | html.escape }}</td><td class="num">{{ item.amount | html.escape }}</td><td class="num">{{ item.reference | html.escape }}</td></tr>
