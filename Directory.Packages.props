<Project>
  <!--
    Central package management: every package version used anywhere in the
    repository is declared here once with a PackageVersion item, and project
    files reference packages without a Version attribute. A version is added
    by the change that first needs the package, within the version matrix.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Valkey" Version="13.6.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
</Project>
