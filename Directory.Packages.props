<Project>
  <!--
    Central package management: every package version used anywhere in the
    repository is declared here once with a PackageVersion item, and project
    files reference packages without a Version attribute. A version is added
    by the change that first needs the package, within the version matrix.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Valkey" Version="13.6.2" />
    <PackageVersion Include="Corvus.Text.Json" Version="5.6.1" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Scriban" Version="7.5.1" />
    <PackageVersion Include="Temporalio" Version="1.21.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Used only by the projects under tests/. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
