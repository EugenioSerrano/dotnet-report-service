## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# The API's artifact routes and their tests are source, not test evidence: the rule
# above matches any directory spelled this way, and on a case-insensitive file
# system it would keep both out of the tree the build reads from git.
!/src/Hosts/ReportService.Api/Artifacts/
!/tests/Hosts/ReportService.Api.Tests/Artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Generated pilot datasets (regenerate with the dataset generator)
samples/datasets/header-items-v1.*.json

# Object storage root of the local composition (shared by the API and the workers)
.storage/

# Template source root of the local composition (the source class, mounted read-only into the PDF worker)
.template-source/

# Visual Studio per-user state (never committed)
.vs/

# Launch profile generated by Visual Studio for the PDF worker; the other projects carry authored profiles
src/Hosts/ReportService.Workers.Pdf/Properties/
