<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one command per test level (hermetic, integration, e2e); see tests/README.md.
    Base class library only; it references no test project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      The job object that owns the processes the runner starts is declared with
      LibraryImport, whose generated marshalling is unsafe by construction: without this
      the compiler emits CS0227 and the build stops. No analyzer is suppressed for it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
